{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-on-rails.dev/schemas/evidence.schema.json",
  "title": "AgentOnRailsEvidence",
  "type": "object",
  "additionalProperties": false,
  "required": ["spec", "result"],
  "properties": {
    "spec": {
      "type": "string",
      "pattern": "^AOR-[0-9]{3}$"
    },
    "task_id": {
      "type": "string",
      "pattern": "^TASK-[0-9]{3}$"
    },
    "implementation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "commit"],
      "properties": {
        "repository": { "type": "string" },
        "commit": { "type": "string", "minLength": 7 },
        "pr": { "type": "string", "format": "uri" }
      }
    },
    "tests": {
      "type": "object",
      "additionalProperties": false,
      "required": ["total", "passed", "failed"],
      "properties": {
        "total": { "type": "integer", "minimum": 0 },
        "passed": { "type": "integer", "minimum": 0 },
        "failed": { "type": "integer", "minimum": 0 },
        "report_uri": { "type": "string" }
      }
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": ["result"],
      "properties": {
        "result": { "type": "string", "enum": ["pass", "fail"] },
        "reviewer": { "type": "string" },
        "notes": { "type": "string" }
      }
    },
    "security": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "result": { "type": "string", "enum": ["pass", "fail", "skipped"] },
        "report_uri": { "type": "string" }
      }
    },
    "deployment": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "environment": { "type": "string" },
        "health_check": { "type": "string", "enum": ["pass", "fail", "skipped"] }
      }
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "log_uri": { "type": "string" },
        "model_tier_final": { "type": "integer", "minimum": 1, "maximum": 3 },
        "attempts": { "type": "integer", "minimum": 0 },
        "estimated_cost_usd": { "type": "number", "minimum": 0 }
      }
    },
    "run_report": {
      "type": "object",
      "additionalProperties": false,
      "required": ["terminal_status"],
      "properties": {
        "spec_id": {
          "type": "string",
          "pattern": "^AOR-[0-9]{3}$"
        },
        "terminal_status": {
          "type": "string",
          "enum": [
            "final_review",
            "human_required",
            "in_progress",
            "done"
          ]
        },
        "completed": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["task_id", "result"],
            "properties": {
              "task_id": {
                "type": "string",
                "pattern": "^TASK-[0-9]{3}$"
              },
              "result": { "type": "string" }
            }
          }
        },
        "blocked_environment": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["task_id", "reason"],
            "properties": {
              "task_id": {
                "type": "string",
                "pattern": "^TASK-[0-9]{3}$"
              },
              "step": { "type": "string" },
              "reason": { "type": "string" },
              "notified": { "type": "boolean" }
            }
          }
        },
        "skipped_due_to_deps": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["task_id"],
            "properties": {
              "task_id": {
                "type": "string",
                "pattern": "^TASK-[0-9]{3}$"
              },
              "waiting_on": {
                "type": "string",
                "pattern": "^TASK-[0-9]{3}$"
              }
            }
          }
        },
        "coding_failures": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["task_id"],
            "properties": {
              "task_id": {
                "type": "string",
                "pattern": "^TASK-[0-9]{3}$"
              },
              "attempts": { "type": "integer", "minimum": 0 },
              "last_tier": { "type": "integer", "minimum": 1, "maximum": 3 }
            }
          }
        },
        "human_actions_needed": {
          "type": "array",
          "items": { "type": "string" }
        },
        "notifications_sent": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["channel"],
            "properties": {
              "channel": { "type": "string" },
              "reason": { "type": "string" },
              "at": { "type": "string", "format": "date-time" }
            }
          }
        },
        "report_uri": { "type": "string" }
      }
    },
    "role_reports": {
      "type": "array",
      "description": "Per-assignment reports (implementor/fixer/reviewer). Items SHOULD validate against role-report.schema.json.",
      "items": {
        "type": "object",
        "required": ["schema_version", "role", "assignment_id", "task_id", "outcome", "summary"],
        "properties": {
          "schema_version": { "type": "string" },
          "role": {
            "type": "string",
            "enum": ["implementor", "fixer", "reviewer"]
          },
          "assignment_id": { "type": "string" },
          "task_id": {
            "type": "string",
            "pattern": "^TASK-[0-9]{3}$"
          },
          "spec_id": {
            "type": "string",
            "pattern": "^AOR-[0-9]{3}$"
          },
          "outcome": { "type": "string" },
          "summary": { "type": "string" },
          "report_uri": { "type": "string" }
        }
      }
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["accepted"],
      "properties": {
        "accepted": { "type": "boolean" },
        "accepted_at": { "type": "string", "format": "date-time" }
      }
    }
  }
}
