{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-on-rails.dev/schemas/project.schema.json",
  "title": "AgentOnRailsProject",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "name", "control_plane_repo", "implementation_repos"],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$",
      "description": "Stable project identifier"
    },
    "name": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "control_plane_repo": {
      "type": "string",
      "description": "GitHub repository that holds authority docs/specs"
    },
    "implementation_repos": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string" }
    },
    "github": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "org": { "type": "string" },
        "labels_prefix": { "type": "string", "default": "aor:" }
      }
    },
    "budgets": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "max_daily_usd": { "type": "number", "minimum": 0 },
        "max_task_usd": { "type": "number", "minimum": 0 }
      }
    }
  }
}
