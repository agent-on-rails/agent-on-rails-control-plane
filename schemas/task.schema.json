{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-on-rails.dev/schemas/task.schema.json",
  "title": "AgentOnRailsTask",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "spec_id", "title", "status"],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^TASK-[0-9]{3}$"
    },
    "spec_id": {
      "type": "string",
      "pattern": "^AOR-[0-9]{3}$"
    },
    "title": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "ready",
        "running",
        "review",
        "failed",
        "escalated",
        "blocked",
        "human_required",
        "done"
      ]
    },
    "depends_on": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^TASK-[0-9]{3}$"
      },
      "uniqueItems": true
    },
    "repository": { "type": "string" },
    "model_tier": {
      "type": "integer",
      "minimum": 1,
      "maximum": 3
    },
    "attempts": {
      "type": "integer",
      "minimum": 0
    },
    "max_attempts": {
      "type": "integer",
      "minimum": 1
    }
  }
}
